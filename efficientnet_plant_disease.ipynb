      "source": [
        "import io\n",
        "import zipfile\n",
        "import torch\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from PIL import Image\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    classification_report,\n",
        "    confusion_matrix,\n",
        "    ConfusionMatrixDisplay\n",
        ")\n",
        "\n",
        "# PlantWild classes excluded from evaluation\n",
        "EXCLUDED_PW_CLASSES = {\n",
        "    \"apple leaf\",\n",
        "    \"apple rust\",\n",
        "    \"apple scab\"\n",
        "}\n",
        "\n",
        "# Create a filtered list of test entries\n",
        "filtered_pw_entries = [\n",
        "    entry for entry in plantwild_test_entries\n",
        "    if entry[0].split(\"/\")[2] not in EXCLUDED_PW_CLASSES\n",
        "]\n",
        "\n",
        "print(\"Number of excluded images by class:\")\n",
        "for pw_name in sorted(EXCLUDED_PW_CLASSES):\n",
        "    count = sum(\n",
        "        entry[0].split(\"/\")[2] == pw_name\n",
        "        for entry in plantwild_test_entries\n",
        "    )\n",
        "    print(f\"{pw_name}: {count}\")\n",
        "\n",
        "print(\"Number of images remaining for evaluation:\", len(filtered_pw_entries))\n",
        "assert len(filtered_pw_entries) > 0, \"No images available for evaluation.\"\n",
        "\n",
        "class PlantWildZipDataset(Dataset):\n",
        "    def __init__(self, zip_path, entries, transform):\n",
        "        self.zip_path = zip_path\n",
        "        self.entries = entries\n",
        "        self.transform = transform\n",
        "        self.zip_file = zipfile.ZipFile(zip_path)\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.entries)\n",
        "\n",
        "    def __getitem__(self, index):\n",
        "        member, label, _ = self.entries[index]\n",
        "        image_bytes = self.zip_file.read(member)\n",
        "        image = Image.open(io.BytesIO(image_bytes)).convert(\"RGB\")\n",
        "        image = self.transform(image)\n",
        "        return image, label\n",
        "\n",
        "filtered_pw_dataset = PlantWildZipDataset(\n",
        "    zip_path,\n",
        "    filtered_pw_entries,\n",
        "    eval_transform\n",
        ")\n",
        "\n",
        "filtered_pw_loader = DataLoader(\n",
        "    filtered_pw_dataset,\n",
        "    batch_size=32,\n",
        "    shuffle=False,\n",
        "    num_workers=0\n",
        ")\n",
        "\n",
        "# Use the classes present in the filtered evaluation data\n",
        "filtered_class_indices = sorted({\n",
        "    int(entry[1]) for entry in filtered_pw_entries\n",
        "})\n",
        "filtered_class_names = [class_names[i] for i in filtered_class_indices]\n",
        "\n",
        "print(\"Number of evaluation classes:\", len(filtered_class_indices))\n",
        "print(\"Evaluation classes:\", filtered_class_names)\n",
        "\n",
        "# Evaluate the model\n",
        "model = model.to(device)\n",
        "model.eval()\n",
        "\n",
        "filtered_labels = []\n",
        "filtered_predictions = []\n",
        "\n",
        "with torch.no_grad():\n",
        "    for images, labels in filtered_pw_loader:\n",
        "        images = images.to(device)\n",
        "        outputs = model(images)\n",
        "\n",
        "        # Restrict predictions to the remaining evaluation classes\n",
        "        outputs = outputs[:, filtered_class_indices]\n",
        "        predicted_positions = outputs.argmax(dim=1).cpu().tolist()\n",
        "\n",
        "        # Convert selected output positions to original Kaggle class indices\n",
        "        predicted_labels = [\n",
        "            filtered_class_indices[position]\n",
        "            for position in predicted_positions\n",
        "        ]\n",
        "\n",
        "        filtered_labels.extend(labels.cpu().tolist())\n",
        "        filtered_predictions.extend(predicted_labels)\n",
        "\n",
        "# Overall metrics\n",
        "pw_accuracy = accuracy_score(filtered_labels, filtered_predictions)\n",
        "\n",
        "pw_precision = precision_score(\n",
        "    filtered_labels,\n",
        "    filtered_predictions,\n",
        "    labels=filtered_class_indices,\n",
        "    average=\"macro\",\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "pw_recall = recall_score(\n",
        "    filtered_labels,\n",
        "    filtered_predictions,\n",
        "    labels=filtered_class_indices,\n",
        "    average=\"macro\",\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "pw_f1 = f1_score(\n",
        "    filtered_labels,\n",
        "    filtered_predictions,\n",
        "    labels=filtered_class_indices,\n",
        "    average=\"macro\",\n",
        "    zero_division=0\n",
        ")\n",
        "\n",
        "print(f\"\\nNumber of PlantWild test images: {len(filtered_labels)}\")\n",
        "print(f\"Number of evaluation classes: {len(filtered_class_names)}\")\n",
        "print(f\"Accuracy: {pw_accuracy:.4f}\")\n",
        "print(f\"Macro Precision: {pw_precision:.4f}\")\n",
        "print(f\"Macro Recall: {pw_recall:.4f}\")\n",
        "print(f\"Macro F1-score: {pw_f1:.4f}\")\n",
        "\n",
        "# Per-class metrics\n",
        "report_dict = classification_report(\n",
        "    filtered_labels,\n",
        "    filtered_predictions,\n",
        "    labels=filtered_class_indices,\n",
        "    target_names=filtered_class_names,\n",
        "    zero_division=0,\n",
        "    digits=4,\n",
        "    output_dict=True\n",
        ")\n",
        "\n",
        "print(\"\\nPer-class classification report:\")\n",
        "print(classification_report(\n",
        "    filtered_labels,\n",
        "    filtered_predictions,\n",
        "    labels=filtered_class_indices,\n",
        "    target_names=filtered_class_names,\n",
        "    zero_division=0,\n",
        "    digits=4\n",
        "))\n",
        "\n",
        "pd.DataFrame(report_dict).transpose().to_csv(\n",
        "    \"efficientnet_plantwild_class_metrics_filtered.csv\"\n",
        ")\n",
        "\n",
        "# Confusion matrix\n",
        "cm_filtered = confusion_matrix(\n",
        "    filtered_labels,\n",
        "    filtered_predictions,\n",
        "    labels=filtered_class_indices\n",
        ")\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(18, 18))\n",
        "ConfusionMatrixDisplay(\n",
        "    confusion_matrix=cm_filtered,\n",
        "    display_labels=filtered_class_names\n",
        ").plot(ax=ax, xticks_rotation=90, cmap=\"Blues\", colorbar=False)\n",
        "\n",
        "plt.title(\"EfficientNet-B0 Confusion Matrix — PlantWild Filtered Classes\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\n",
        "    \"efficientnet_plantwild_confusion_matrix_filtered.png\",\n",
        "    dpi=300,\n",
        "    bbox_inches=\"tight\"\n",
        ")\n",
        "plt.show()"
      ],
